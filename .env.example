# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical tags, Open Graph URLs,
# the sitemap, robots.txt and the LocalBusiness JSON-LD.
# Leave unset in production: it defaults to https://dammasexpress.ae.
# Useful on preview deployments so canonicals don't claim to be production.
NEXT_PUBLIC_SITE_URL=

# --- Analytics -------------------------------------------------------------
# GA4 measurement ID. Analytics is disabled entirely while this is empty, so
# local dev and previews stay out of the reporting data.
# Find it in GA4 > Admin > Data Streams > your web stream.
# Mark `generate_lead` as a key event in GA4 so form submissions and calls show
# up as conversions rather than plain page views.
NEXT_PUBLIC_GA_ID=
